                          children: [
                            Icon(Icons.my_location),
                            SizedBox(width: 12),
                            Text('Actualizar ubicación GPS'),
                          ],
                        ),
                      ),
                    ),
                    const SizedBox(height: 24),
                    const Text('Evidencia fotográfica (actuales y nuevas)',
